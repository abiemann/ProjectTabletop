<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Hand and button analysis runs on every camera frame. Unoptimized Debug
         code made search-light acquisition frames take 100-300 ms. -->
    <Optimize>true</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20260627" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260627" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Regression/**/*.cs" />
    <InternalsVisibleTo Include="ProjectTabletop.Vision.Regression" />
    <Content Include="Models/Hands/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
