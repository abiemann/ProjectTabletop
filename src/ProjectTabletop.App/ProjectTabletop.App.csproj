<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <UseWinUI>true</UseWinUI>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <WinUISDKReferences>false</WinUISDKReferences>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
    <PackageReference Include="ComputeSharp.D2D1.WinUI" Version="3.2.0" />
    <ProjectReference Include="..\ProjectTabletop.Calibration\ProjectTabletop.Calibration.csproj" />
    <ProjectReference Include="..\ProjectTabletop.Vision\ProjectTabletop.Vision.csproj" />
    <ProjectReference Include="..\ProjectTabletop.Interaction\ProjectTabletop.Interaction.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\THIRD_PARTY_NOTICES.md" Link="THIRD_PARTY_NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="GlobeRendering\Assets\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="SlotsRendering\Assets\*.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\Roulette\*.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\WaterGarden\*.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\CrownDeed\*.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\CrownDeed\Pieces\*.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\MenuPreviews\*.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- The unpackaged WinUI build copies these generated resources to bin, but
       the SDK's publish item list does not include them automatically. Keep
       direct dotnet publish and the release scripts on the same resource path. -->
  <Target Name="IncludeTabletopWinUIResourcesInPublish"
          BeforeTargets="ComputeFilesToPublish"
          DependsOnTargets="Prep_ComputeProcessXamlFiles"
          Condition="'$(WindowsPackageType)' == 'None'">
    <AssignTargetPath Files="@(GeneratedXamlSrc)" RootFolder="$(XamlGeneratedOutputPath)">
      <Output TaskParameter="AssignedFiles" ItemName="_TabletopPublishXaml" />
    </AssignTargetPath>
    <Error Condition="'@(_TabletopPublishXaml)' == ''"
           Text="No generated WinUI XAML resources were found for publication." />
    <Error Condition="!Exists('%(_TabletopPublishXaml.Identity)')"
           Text="Generated WinUI resource is missing: %(_TabletopPublishXaml.Identity)" />
    <Error Condition="'$(ProjectPriFullPath)' == '' or !Exists('$(ProjectPriFullPath)')"
           Text="The generated WinUI resource index is missing: $(ProjectPriFullPath)" />
    <ItemGroup>
      <ResolvedFileToPublish Include="@(_TabletopPublishXaml)">
        <RelativePath>%(_TabletopPublishXaml.TargetPath)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
      <ResolvedFileToPublish Include="$(ProjectPriFullPath)">
        <RelativePath>$(ProjectPriFileName)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
