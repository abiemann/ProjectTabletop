<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ProjectTabletop.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    Title="Project Tabletop">
    <Grid Background="{StaticResource TabletopChassisBrush}" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="448" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <ScrollViewer Grid.Column="0" Margin="16,16,0,16" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="14" Padding="0,0,8,0">
                <Border Style="{StaticResource WorkstationPanelStyle}" Background="{StaticResource TabletopHeaderBrush}">
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Background="{StaticResource TabletopAccentBrush}" CornerRadius="2" />
                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock Text="PROJECT TABLETOP" FontSize="23" FontWeight="SemiBold" CharacterSpacing="50" />
                                <TextBlock Text="Camera · Projector · Interaction" Foreground="{StaticResource TabletopMutedBrush}" />
                            </StackPanel>
                        </Grid>
                        <Border Height="1" Background="{StaticResource TabletopPanelBorderBrush}" Margin="0,5" />
                        <TextBlock x:Name="StatusText" Text="Ready. Scan the board to open its menu, then point and pinch to choose a board." TextWrapping="Wrap" Foreground="{StaticResource TabletopMutedBrush}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource WorkstationPanelStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="01 / CAMERA INPUT" Style="{StaticResource SectionTitleStyle}" />
                        <ComboBox x:Name="CameraComboBox" PlaceholderText="Select webcam" HorizontalAlignment="Stretch" SelectionChanged="CameraComboBox_SelectionChanged" />
                        <ComboBox x:Name="CameraFrameRateComboBox" Header="Frame rate" HorizontalAlignment="Stretch"
                                  SelectedIndex="0" SelectionChanged="CameraFrameRate_SelectionChanged">
                            <ComboBoxItem Content="30 fps" Tag="30" />
                            <ComboBoxItem Content="60 fps" Tag="60" />
                            <ComboBoxItem Content="100 fps" Tag="100" />
                        </ComboBox>
                        <TextBlock x:Name="CameraFrameRateStatusText" Text="Choose a frame rate, then start the camera."
                                   TextWrapping="Wrap" Foreground="{StaticResource TabletopMutedBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Refresh" Click="RefreshCameras_Click" />
                            <Button Content="Start camera" Click="StartCamera_Click" />
                            <Button Content="Stop" Click="StopCamera_Click" />
                        </StackPanel>
                        <TextBlock x:Name="CameraStatusText" Text="Camera stopped" TextWrapping="Wrap" Foreground="{StaticResource TabletopMutedBrush}" />
                        <NumberBox x:Name="ProjectorLatencyNumberBox" Header="Projector latency (ms)" Value="17"
                                   Minimum="0" Maximum="2000" SmallChange="1" SpinButtonPlacementMode="Compact"
                                   ValueChanged="ProjectorLatency_ValueChanged"
                                   ToolTipService.ToolTip="Subtracted from the setup-dot response time. Saved for the selected projector and display mode; changing it recalculates the current result." />
                        <TextBlock x:Name="CameraLatencyText" Text="Estimated camera latency: measured during board setup."
                                   TextWrapping="Wrap" Foreground="{StaticResource TabletopMutedBrush}"
                                   ToolTipService.ToolTip="First observed setup-dot frame minus its first projector draw minus the entered projector latency. Includes camera exposure, buffering and delivery; display scheduling and frame sampling affect this estimate." />
                    </StackPanel>
                </Border>

                <Border x:Name="ProjectionOutputPanel" Style="{StaticResource WorkstationPanelStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="02 / PROJECTION OUTPUT" Style="{StaticResource SectionTitleStyle}" />
                        <ComboBox x:Name="DisplayComboBox" PlaceholderText="Select projector display" HorizontalAlignment="Stretch" SelectionChanged="DisplayComboBox_SelectionChanged" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Refresh" Click="RefreshDisplays_Click" />
                            <Button x:Name="OpenOutputButton" Content="Open output" Click="OpenOutput_Click" />
                            <Button x:Name="FullscreenButton" Content="Full screen" Click="Fullscreen_Click" />
                        </StackPanel>
                        <TextBlock x:Name="ProjectionPropertiesText" Text="Reading output display properties."
                                   TextWrapping="Wrap" Foreground="{StaticResource TabletopMutedBrush}" />
                        <Button x:Name="RotateBoardButton" Content="Rotate board 90°" IsEnabled="False" Click="RotateBoard_Click" />
                        <TextBlock x:Name="BoardFacingStatusText" Text="Board setup will remember the board's facing direction."
                                   TextWrapping="Wrap" Foreground="{StaticResource TabletopMutedBrush}" />
                        <CheckBox x:Name="EnableDisplayAudioCheckBox" Content="Enable Audio on Display Device"
                                  IsEnabled="False" IsChecked="False" Checked="EnableDisplayAudio_Changed"
                                  Unchecked="EnableDisplayAudio_Changed" />
                        <TextBlock x:Name="DisplayAudioStatusText" Text="Open output to check display audio."
                                   TextWrapping="Wrap" Foreground="{StaticResource TabletopMutedBrush}" />
                        <NumberBox x:Name="ProjectorLensHeightNumberBox" Header="Lens height above board (cm, optional)"
                                   Minimum="0.1" Maximum="10000" SmallChange="1" PlaceholderText="Height in cm"
                                   SpinButtonPlacementMode="Compact" ValueChanged="ProjectorSize_ValueChanged" />
                        <NumberBox x:Name="ProjectorThrowRatioNumberBox" Header="Throw ratio (optional)"
                                   Minimum="0.01" Maximum="100" SmallChange="0.01" PlaceholderText="From your projector's specifications"
                                   SpinButtonPlacementMode="Compact" ValueChanged="ProjectorSize_ValueChanged" />
                        <TextBlock Text="Enter the ratio before :1. Estimates assume the lens points straight down and the full native image has no zoom or keystone correction."
                                   TextWrapping="Wrap" Foreground="{StaticResource TabletopMutedBrush}" />
                        <Expander x:Name="MeasuredBoardSizeExpander" Header="Measured board size (optional)" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <StackPanel Spacing="10">
                                <NumberBox x:Name="MeasuredBoardShortSideNumberBox" Header="Short side (cm)"
                                           Minimum="0.1" Maximum="10000" SmallChange="0.1" PlaceholderText="Measured with a ruler"
                                           SpinButtonPlacementMode="Compact" ValueChanged="ProjectorSize_ValueChanged" />
                                <NumberBox x:Name="MeasuredBoardLongSideNumberBox" Header="Long side (cm)"
                                           Minimum="0.1" Maximum="10000" SmallChange="0.1" PlaceholderText="Measured with a ruler"
                                           SpinButtonPlacementMode="Compact" ValueChanged="ProjectorSize_ValueChanged" />
                                <TextBlock Text="Both measurements take priority over the optical estimate. Update or clear them when you change boards."
                                           TextWrapping="Wrap" Foreground="{StaticResource TabletopMutedBrush}" />
                            </StackPanel>
                        </Expander>
                        <TextBlock x:Name="BoardSizeEstimateText" Text="Optional: enter both values to show estimated dimensions on Hand-Tracking."
                                   TextWrapping="Wrap" Foreground="{StaticResource TabletopMutedBrush}" />
                        <TextBlock x:Name="ProjectionSettingsStatusText" TextWrapping="Wrap" Visibility="Collapsed"
                                   Foreground="{StaticResource TabletopMutedBrush}" />
                        <TextBlock Text="Projection stays black until board setup completes, then fills the detected board." TextWrapping="Wrap" Foreground="{StaticResource TabletopMutedBrush}" />
                        <TextBlock x:Name="RenderStatusText" Text="Waiting for projection diagnostics." TextWrapping="Wrap" Foreground="{StaticResource TabletopMutedBrush}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource WorkstationPanelStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="03 / BOARD CONTROL" Style="{StaticResource SectionTitleStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="BoardSetupButton" Content="Start board setup" Click="BoardSetup_Click" Background="{StaticResource TabletopPrimaryButtonBrush}" BorderBrush="{StaticResource TabletopAccentBrush}" />
                            <Button x:Name="RescanBoardButton" Content="Scan again" Click="RescanBoard_Click" IsEnabled="False" />
                        </StackPanel>
                        <TextBlock x:Name="BoardSetupStatusText" Text="Board setup first finds the cardboard under black output, then uses white projection and five alignment spots to fit its grid." TextWrapping="Wrap" Foreground="{StaticResource TabletopMutedBrush}" />
                        <Expander x:Name="MarkerSetupExpander" Header="Marker setup" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Use two equal parallel black bars with a clear gap on a light backing. Follow the projected position targets, slide between the two rings and back, then lift the marker away. Save becomes available after all checks pass." TextWrapping="Wrap" Foreground="{StaticResource TabletopMutedBrush}" />
                                <ComboBox x:Name="MarkerSetupTargetCombo" Header="Set up" SelectedIndex="0" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="Water Garden / Paint marker" />
                                    <ComboBoxItem Content="Football player 1" />
                                    <ComboBoxItem Content="Football player 2" />
                                </ComboBox>
                                <TextBlock Text="Water Garden and Paint share a saved marker. Open either board first to check or train it on that surface." TextWrapping="Wrap" Foreground="{StaticResource TabletopMutedBrush}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="StartMarkerSetupButton" Content="Start setup" Click="StartMarkerSetup_Click" />
                                    <Button x:Name="RecheckMarkerSetupButton" Content="Recheck saved marker" Click="RecheckMarkerSetup_Click" />
                                </StackPanel>
                                <TextBlock x:Name="MarkerSetupStatusText" Text="Start the camera and scan the board, then choose a marker to set up." TextWrapping="Wrap" />
                                <ProgressBar x:Name="MarkerSetupProgress" Minimum="0" Maximum="100" Value="0" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="SaveMarkerSetupButton" Content="Save marker" Click="SaveMarkerSetup_Click" IsEnabled="False" />
                                    <Button x:Name="CancelMarkerSetupButton" Content="Cancel" Click="CancelMarkerSetup_Click" IsEnabled="False" />
                                </StackPanel>
                            </StackPanel>
                        </Expander>
                        <Border Height="1" Background="{StaticResource TabletopPanelBorderBrush}" Margin="0,2" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Board menu" Click="BoardMenu_Click" />
                            <Button Content="Settings" Click="Settings_Click" />
                            <Button Content="Hand-Tracking test" Click="HandTrackingTest_Click" />
                        </StackPanel>
                        <Border x:Name="SettingsToolsPanel" Visibility="Collapsed" Background="{StaticResource TabletopInsetBrush}" BorderBrush="{StaticResource TabletopPanelBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                            <StackPanel Spacing="9">
                                <TextBlock Text="SETTINGS" Style="{StaticResource SectionTitleStyle}" />
                                <Button x:Name="LicensesButton" Content="Licenses and notices" Click="Licenses_Click" />
                                <TextBlock Text="Read the project license and included third-party terms on this laptop." TextWrapping="Wrap" Foreground="{StaticResource TabletopMutedBrush}" />
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="BoardAppStatusText" Text="Board menu. Complete board setup to project it." TextWrapping="Wrap" />
                        <TextBlock Text="Bring your four fingers together and aim with the middle fingertip. When the button says Ready, move your index finger sideways to select. Bring it back to select again. Point and pinch also works." TextWrapping="Wrap" Foreground="{StaticResource TabletopMutedBrush}" />
                        <Button Content="Dragon Slots" Click="Slots_Click" />
                        <TextBlock Text="Spin a five-reel, 40-line dragon slot machine with virtual credits. Every control is a long press: rest your fingers on SPIN for a second. Coins with a power egg start Dragonfire Respins, three elixirs start free spins, and five keys open the Treasure Vault. Laptop clicks also work." TextWrapping="Wrap" Foreground="{StaticResource TabletopMutedBrush}" />
                        <Button Content="Photo Copy" Click="PhotoCopy_Click" />
                        <TextBlock Text="Place an object on grey above the bottom controls, then lift your hands to lock its light. Hold the up arrow for a second to reveal EXIT, SWIRL and COPY. Cover a caption for a second to select it, then uncover it before pressing again. SWIRL becomes CLEAR and COPY becomes SAVE while copies are displayed. Images go to Pictures / Project Tabletop." TextWrapping="Wrap" Foreground="{StaticResource TabletopMutedBrush}" />
                        <Button Content="Blackjack" Click="Blackjack_Click" />
                        <TextBlock Text="Play the dealer with virtual chips. Aim with four fingers together, then move your index finger sideways to select, or click the laptop table. The laptop table works with the projector off." TextWrapping="Wrap" Foreground="{StaticResource TabletopMutedBrush}" />
                        <Button Content="Water Garden" Click="WaterGarden_Click" />
                        <TextBlock Text="Use Marker setup above to train the Water Garden wand, then move its marker across the water to make ripples. Open the bottom-left arrow to find EXIT, RESET, and DUCK+. Hold a projected control for one second, then uncover it before pressing again. Laptop clicks also work." TextWrapping="Wrap" Foreground="{StaticResource TabletopMutedBrush}" />
                        <Button Content="Football" Click="OnOpenFootballBoard" />
                        <Button Content="Stryker's Run" Click="OnOpenStrykersRunBoard" />
                        <TextBlock Text="Kick a lively football with a black bar, a double-bar marker or your index finger. Play against the computer or another person, defending opposite goals. Player 1 uses the left half; player 2 uses the right." TextWrapping="Wrap" Foreground="{StaticResource TabletopMutedBrush}" />
                        <Expander Header="Football game" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <StackPanel Spacing="10">
                                <ComboBox x:Name="FootballModeBox" Header="Players" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="OnFootballModeChanged">
                                    <ComboBoxItem Content="One player against AI" />
                                    <ComboBoxItem Content="Two human players" />
                                </ComboBox>
                                <ComboBox x:Name="FootballPlayer1StyleBox" Header="Player 1 kicker" SelectedIndex="0" Tag="0" HorizontalAlignment="Stretch" SelectionChanged="OnFootballStyleChanged">
                                    <ComboBoxItem Content="Car front" />
                                    <ComboBoxItem Content="Boxing glove" />
                                    <ComboBoxItem Content="Frying pan" />
                                    <ComboBoxItem Content="Football boot" />
                                </ComboBox>
                                <ComboBox x:Name="FootballPlayer2StyleBox" Header="Player 2 / AI kicker" SelectedIndex="0" Tag="1" HorizontalAlignment="Stretch" SelectionChanged="OnFootballStyleChanged">
                                    <ComboBoxItem Content="Car front" />
                                    <ComboBoxItem Content="Boxing glove" />
                                    <ComboBoxItem Content="Frying pan" />
                                    <ComboBoxItem Content="Football boot" />
                                </ComboBox>
                                <ComboBox x:Name="FootballPlayer1Input" Header="Player 1 input" Tag="0" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="FootballInputMode_SelectionChanged">
                                    <ComboBoxItem Content="Double-bar marker" />
                                    <ComboBoxItem Content="Index fingertip" />
                                </ComboBox>
                                <ComboBox x:Name="FootballPlayer2Input" Header="Player 2 input" Tag="1" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="FootballInputMode_SelectionChanged">
                                    <ComboBoxItem Content="Double-bar marker" />
                                    <ComboBoxItem Content="Index fingertip" />
                                </ComboBox>
                                <TextBlock x:Name="FootballInputStatusText" Text="Use Marker setup for each human player's marker, or choose Index fingertip." TextWrapping="Wrap" />
                                <Button Content="Reset football match" Click="OnResetFootball" />
                                <TextBlock Text="Use Marker setup above to train each human player. Keep one marker in each half; player 1 uses the left and player 2 the right. Every kicker uses the same contact size." TextWrapping="Wrap" Foreground="{StaticResource TabletopMutedBrush}" />
                            </StackPanel>
                        </Expander>
                        <Button Content="Crown &amp; Deed" Click="CrownDeed_Click" />
                        <TextBlock Text="Choose 2–6 human and AI players, then play on the gold-and-emerald board. Click the laptop table or use the same four-finger selection gesture. Open the up-arrow drawer for Save and Exit during a game; saved games can be resumed." TextWrapping="Wrap" Foreground="{StaticResource TabletopMutedBrush}" />
                        <Button Content="Globe" Click="Globe_Click" />
                        <TextBlock Text="Explore a detailed Earth with a distant arrival and slow spin. Hold the bottom up arrow for a second to reveal Exit and zoom controls. Hold their captions or click the laptop controls; zoom repeats while covered." TextWrapping="Wrap" Foreground="{StaticResource TabletopMutedBrush}" />
                        <Border Height="1" Background="{StaticResource TabletopPanelBorderBrush}" Margin="0,2" />
                        <TextBlock Text="Background media" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Choose video or image" Click="ChooseBackground_Click" />
                            <Button Content="Test grid" Click="TestGrid_Click" />
                        </StackPanel>
                        <TextBlock x:Name="BackgroundPathText" Text="No background media selected" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TabletopMutedBrush}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource WorkstationPanelStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="04 / HAND INTERACTION" Style="{StaticResource SectionTitleStyle}" />
                        <ToggleSwitch x:Name="HandTrackingToggle" Header="Hand tracking and spotlight" IsOn="True" Toggled="HandTrackingToggle_Toggled" />
                        <TextBlock x:Name="HandTrackingStatusText" Text="Start the webcam to track your fingers." TextWrapping="Wrap" />
                        <TextBlock Text="Keep your hand near the board. A white spotlight follows detected fingers; lifting your hand can offset the projection. The camera must see the hand before its light can appear." TextWrapping="Wrap" Foreground="{StaticResource TabletopMutedBrush}" />
                        <TextBlock Text="Open Hand-Tracking for the test grid. Extend and separate all fingers to show &quot;Spread out hand&quot;. Pinch thumb and index finger for a one-second red circle, then release. Photo Copy uses a grey surface with separate lights for the object and your hand." TextWrapping="Wrap" Foreground="{StaticResource TabletopMutedBrush}" />
                        <Border Background="{StaticResource TabletopInsetBrush}" BorderBrush="{StaticResource TabletopPanelBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                            <StackPanel Spacing="9">
                                <TextBlock Text="RECORDING &amp; DIAGNOSTICS" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TabletopSecondaryAccentBrush}" CharacterSpacing="60" />
                                <TextBlock x:Name="HandDetectionLogStatusText" Text="Full detection logging starts automatically in the Hand-Tracking tester." TextWrapping="Wrap" IsTextSelectionEnabled="True" Foreground="{StaticResource TabletopMutedBrush}" />
                                <TextBlock x:Name="HandVideoRecordingStatusText" Text="Hand video records automatically in the Hand-Tracking tester only." TextWrapping="Wrap" IsTextSelectionEnabled="True" Foreground="{StaticResource TabletopMutedBrush}" />
                            </StackPanel>
                        </Border>
                        <Button Content="Save raw camera PNG" Click="SaveRawSnapshot_Click" />
                    </StackPanel>
                </Border>

                <TextBlock Text="Media decoding and 4K/60 performance must be checked on the connected laptop and projector." TextWrapping="Wrap" FontStyle="Italic" Margin="0,8,0,12" />
            </StackPanel>
        </ScrollViewer>
        <Grid Grid.Column="1" RowSpacing="16" Margin="0,16,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border x:Name="CameraPreviewPanel" Grid.Row="0" Background="{StaticResource TabletopPanelBrush}" BorderBrush="{StaticResource TabletopViewportBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="8">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Background="{StaticResource TabletopHeaderBrush}" CornerRadius="9" Padding="14,11">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Background="{StaticResource TabletopAccentBrush}" CornerRadius="2" />
                            <TextBlock x:Name="CameraPreviewTitleText" Grid.Column="1" Text="CAMERA  ·  live fingertip tracking" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TabletopAccentBrush}" CharacterSpacing="40" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Background="{StaticResource TabletopViewportBrush}" BorderBrush="{StaticResource TabletopPanelBorderBrush}" BorderThickness="1" CornerRadius="9">
                        <canvas:CanvasControl x:Name="CameraCanvas" UseSharedDevice="True" Draw="CameraCanvas_Draw" PointerPressed="CameraCanvas_PointerPressed" />
                    </Border>
                </Grid>
            </Border>
            <Border x:Name="ProjectionPreviewPanel" Grid.Row="1" Background="{StaticResource TabletopPanelBrush}" BorderBrush="{StaticResource TabletopViewportBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="8">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Background="{StaticResource TabletopHeaderBrush}" CornerRadius="9" Padding="14,11">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Background="{StaticResource TabletopSecondaryAccentBrush}" CornerRadius="2" />
                            <TextBlock Grid.Column="1" Text="PROJECTION PREVIEW  ·  mapped board output" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TabletopAccentBrush}" CharacterSpacing="40" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <ToggleSwitch x:Name="ProjectionPreviewToggle" Grid.Column="2" IsOn="True" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center"
                                          AutomationProperties.Name="Projection preview" ToolTipService.ToolTip="Show the laptop board preview. Projector output and camera tracking stay active."
                                          Toggled="ProjectionPreviewToggle_Toggled" />
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Background="Black" BorderBrush="{StaticResource TabletopPanelBorderBrush}" BorderThickness="1" CornerRadius="9">
                        <Grid>
                            <canvas:CanvasAnimatedControl x:Name="ProjectionPreview" UseSharedDevice="True" Paused="True" Draw="ProjectionPreview_Draw" />
                            <TextBlock x:Name="ProjectionPreviewOffText" Text="Preview is off" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TabletopMutedBrush}" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
            <Border x:Name="BlackjackPreviewPanel" Grid.RowSpan="2" Visibility="Collapsed" Background="{StaticResource TabletopPanelBrush}" BorderBrush="{StaticResource TabletopViewportBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="8">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Background="{StaticResource TabletopHeaderBrush}" CornerRadius="9" Padding="14,11">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="BoardGamePreviewTitle" Text="BLACKJACK  ·  click the table to play  ·  virtual chips" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TabletopAccentBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <ToggleSwitch x:Name="BoardGamePreviewToggle" Grid.Column="1" IsOn="True" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center"
                                          AutomationProperties.Name="Projection preview" ToolTipService.ToolTip="Show the laptop board preview. Projector output and camera tracking stay active."
                                          Toggled="ProjectionPreviewToggle_Toggled" />
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1" Background="Black">
                        <canvas:CanvasAnimatedControl x:Name="BlackjackPreview" UseSharedDevice="True" Paused="True" Draw="BlackjackPreview_Draw" PointerPressed="BlackjackPreview_PointerPressed" />
                        <TextBlock x:Name="BoardGamePreviewOffText" Text="Preview is off" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TabletopMutedBrush}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
