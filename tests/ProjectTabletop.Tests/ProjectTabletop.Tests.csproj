<Project Sdk="Microsoft.NET.Sdk">
  <!-- xUnit wrappers around the offline console suites. Each existing check group
       runs as its own test; the console entrypoints remain available. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <DefineConstants>$(DefineConstants);OFFLINE_VERIFICATION</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\ProjectTabletop.Interaction\Verification\ProjectTabletop.Interaction.Verification.csproj" />
    <ProjectReference Include="..\..\src\ProjectTabletop.Calibration\Verification\ProjectTabletop.Calibration.Verification.csproj" />
    <ProjectReference Include="..\..\src\ProjectTabletop.Vision\Regression\ProjectTabletop.Vision.Regression.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Compile Include="..\..\src\ProjectTabletop.App\ExclusiveProcessLease.cs" Link="App\ExclusiveProcessLease.cs" />
    <Compile Include="..\..\src\ProjectTabletop.App\BoardImageDirectories.cs" Link="App\BoardImageDirectories.cs" />
    <Compile Include="..\..\src\ProjectTabletop.App\Projection\WaterGarden\WaterFountainFluid.cs" Link="App\WaterFountainFluid.cs" />
    <Compile Include="..\..\src\ProjectTabletop.App\Projection\WaterGarden\WaterFountainLayout.cs" Link="App\WaterFountainLayout.cs" />
    <Compile Include="..\..\src\ProjectTabletop.App\Projection\WaterGarden\WaterGardenView.cs" Link="App\WaterGardenView.cs" />
    <Compile Include="..\..\src\ProjectTabletop.App\MarkerSetupFirstUse.cs" Link="App\MarkerSetupFirstUse.cs" />
    <Compile Include="..\..\src\ProjectTabletop.App\Camera\CameraAccessBlockedException.cs" Link="App\CameraAccessBlockedException.cs" />
    <Compile Include="..\..\src\ProjectTabletop.App\Camera\CameraFrame.cs" Link="App\CameraFrame.cs" />
    <Compile Include="..\..\src\ProjectTabletop.App\Camera\CameraFramePool.cs" Link="App\CameraFramePool.cs" />
    <Compile Include="..\..\src\ProjectTabletop.App\Camera\CameraFrameRatePolicy.cs" Link="App\CameraFrameRatePolicy.cs" />
    <Compile Include="..\..\src\ProjectTabletop.App\Camera\FrameWorker.cs" Link="App\FrameWorker.cs" />
    <Compile Include="..\..\src\ProjectTabletop.App\Camera\LatestFrameWorker.cs" Link="App\LatestFrameWorker.cs" />
    <Compile Include="..\..\src\ProjectTabletop.App\Camera\CoalescedDispatch.cs" Link="App\CoalescedDispatch.cs" />
    <Compile Include="..\..\src\ProjectTabletop.App\HandTrackingVideoRecorder.cs" Link="App\HandTrackingVideoRecorder.cs" />
    <Compile Include="..\..\src\ProjectTabletop.App\HandTrackingVideoRecorderVerification.cs" Link="App\HandTrackingVideoRecorderVerification.cs" />
    <Compile Include="..\..\src\ProjectTabletop.App\Settings\FootballMarkerSettingsStore.cs" Link="App\FootballMarkerSettingsStore.cs" />
    <Compile Include="..\..\src\ProjectTabletop.App\Settings\DoubleBarProfileSelection.cs" Link="App\DoubleBarProfileSelection.cs" />
    <Compile Include="..\..\src\ProjectTabletop.App\Settings\DoubleBarMarkerSettings.cs" Link="App\DoubleBarMarkerSettings.cs" />
    <Compile Include="..\..\src\ProjectTabletop.App\Settings\CameraFrameRateSettingsStore.cs" Link="App\CameraFrameRateSettingsStore.cs" />
    <Compile Include="..\..\src\ProjectTabletop.App\Settings\DuckHuntMicrophoneSettingsStore.cs" Link="App\DuckHuntMicrophoneSettingsStore.cs" />
