<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AppBuildDirectory Condition="'$(AppBuildDirectory)' == ''">$(MSBuildThisFileDirectory)..\..\src\ProjectTabletop.App\bin\x64\Debug\net10.0-windows10.0.26100.0\win-x64</AppBuildDirectory>
    <AppManifestPath Condition="'$(AppManifestPath)' == ''">$(MSBuildThisFileDirectory)..\..\src\ProjectTabletop.App\obj\x64\Debug\net10.0-windows10.0.26100.0\win-x64\Manifests\app.manifest</AppManifestPath>
    <ApplicationManifest>$(AppManifestPath)</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Microsoft.Graphics.Canvas.Interop"><HintPath>$(AppBuildDirectory)\Microsoft.Graphics.Canvas.Interop.dll</HintPath></Reference>
    <Reference Include="WinRT.Runtime"><HintPath>$(AppBuildDirectory)\WinRT.Runtime.dll</HintPath></Reference>
    <Reference Include="ProjectTabletop.Interaction"><HintPath>$(AppBuildDirectory)\ProjectTabletop.Interaction.dll</HintPath></Reference>
  </ItemGroup>
  <Target Name="RequireBuiltApplication" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(AppBuildDirectory)\ProjectTabletop.App.dll')" Text="Build the application first, or use Generate.ps1 to build and stage its native runtime." />
  </Target>
</Project>
